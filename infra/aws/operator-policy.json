{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetEbsEncryptionByDefault",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "pricing:GetProducts",
        "pricing:DescribeServices",
        "pricing:GetAttributeValues",
        "servicequotas:GetServiceQuota",
        "servicequotas:GetAWSDefaultServiceQuota",
        "sts:GetCallerIdentity",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadBill",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadPublicImageParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:*::parameter/aws/service/*"
    },
    {
      "Sid": "ReadOzboxIam",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetInstanceProfile",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRoleTags",
        "iam:ListInstanceProfileTags"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/ozbox-*",
        "arn:aws:iam::${account_id}:instance-profile/ozbox-*"
      ]
    },
    {
      "Sid": "CreateTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateInternetGateway",
        "ec2:AllocateAddress",
        "ec2:CreateVolume",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateNatGateway",
        "ec2:CreateSnapshot"
      ],
      "Resource": [
        "arn:aws:ec2:*:${account_id}:vpc/*",
        "arn:aws:ec2:*:${account_id}:internet-gateway/*",
        "arn:aws:ec2:*:${account_id}:elastic-ip/*",
        "arn:aws:ec2:*:${account_id}:volume/*",
        "arn:aws:ec2:*:${account_id}:subnet/*",
        "arn:aws:ec2:*:${account_id}:route-table/*",
        "arn:aws:ec2:*:${account_id}:security-group/*",
        "arn:aws:ec2:*:${account_id}:natgateway/*",
        "arn:aws:ec2:*::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "RunTaggedInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:${account_id}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "RunInstancesBaseResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*:${account_id}:network-interface/*",
        "arn:aws:ec2:*:${account_id}:volume/*"
      ]
    },
    {
      "Sid": "RunInstancesInOzboxNetworks",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*:${account_id}:subnet/*",
        "arn:aws:ec2:*:${account_id}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "TagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:*:${account_id}:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateVpc",
            "CreateInternetGateway",
            "AllocateAddress",
            "CreateSubnet",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateNatGateway",
            "CreateSnapshot"
          ]
        }
      }
    },
    {
      "Sid": "TagOnCreateSnapshot",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSnapshot"
        }
      }
    },
    {
      "Sid": "CreateVolumeFromOurSnapshots",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "ChangeOnlyTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:ModifyVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:CreateSnapshot",
        "ec2:DeleteSnapshot",
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteVpc",
        "ec2:CreateSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteSubnet",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateNatGateway",
        "ec2:DeleteNatGateway",
        "ec2:ReleaseAddress"
      ],
      "Resource": [
        "arn:aws:ec2:*:${account_id}:*/*",
        "arn:aws:ec2:*::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "ReadTheAccountsBoxPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "arn:aws:iam::${account_id}:policy/ozbox-box-*"
    },
    {
      "Sid": "CreateOzboxBoxRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/ozbox-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "ManageOzboxBoxRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/ozbox-*",
      "Condition": {
        "StringEquals": {
          "iam:ResourceTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "ManageOzboxInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": "arn:aws:iam::${account_id}:instance-profile/ozbox-*"
    },
    {
      "Sid": "AttachOnlyTheAccountsBoxPolicies",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::${account_id}:role/ozbox-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::${account_id}:policy/ozbox-box-session-manager",
            "arn:aws:iam::${account_id}:policy/ozbox-box-parameters",
            "arn:aws:iam::${account_id}:policy/ozbox-box-parameters-key",
            "arn:aws:iam::${account_id}:policy/ozbox-box-session-logs"
          ]
        }
      }
    },
    {
      "Sid": "AttachTheFleetKeyPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::${account_id}:role/ozbox-*",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:aws:iam::${account_id}:policy/ozbox-box-fleet-key-*"
        }
      }
    },
    {
      "Sid": "PassOzboxRolesToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/ozbox-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "StartSessionsOnOzboxInstances",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:*:${account_id}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ozbox-managed": "true"
        }
      }
    },
    {
      "Sid": "StartSessionDocuments",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ssm:*::document/AWS-StartSSHSession",
        "arn:aws:ssm:*:${account_id}:document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "EndOwnSessionsOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/${aws:username}-*"
    },
    {
      "Sid": "PushSshKeysToOzboxInstances",
      "Effect": "Allow",
      "Action": "ec2-instance-connect:SendSSHPublicKey",
      "Resource": "arn:aws:ec2:*:${account_id}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ozbox-managed": "true",
          "ec2:osuser": [
            "ozbox",
            "ozbox-ingress"
          ]
        }
      }
    },
    {
      "Sid": "OzboxStateBucketsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::ozbox-tfstate-*"
    },
    {
      "Sid": "OzboxStateObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::ozbox-tfstate-*/*"
    },
    {
      "Sid": "NeverTouchTheReservedObxRoles",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/obx/*",
        "arn:aws:iam::*:role/obx-*",
        "arn:aws:iam::*:role/*/obx-*"
      ]
    },
    {
      "Sid": "NeverGrantAccessOrOpenInbound",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:PutRolePolicy",
        "iam:PutUserPolicy",
        "iam:PutGroupPolicy",
        "iam:AttachUserPolicy",
        "iam:AttachGroupPolicy",
        "organizations:*",
        "sso:*",
        "account:*",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "*"
    }
  ]
}
