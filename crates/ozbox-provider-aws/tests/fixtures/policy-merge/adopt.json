{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "SendOnlyTheAdoptDocument", "Effect": "Allow", "Action": ["ssm:SendCommand"], "Resource": ["arn:aws:ssm:us-east-1:123456789012:document/ozbox-adopt-ozbox"] },
    { "Sid": "ToBoxesOzBoxManages", "Effect": "Allow", "Action": ["ssm:SendCommand"], "Resource": ["arn:aws:ec2:us-east-1:123456789012:instance/*"], "Condition": { "StringEquals": { "ssm:resourceTag/ozbox-managed": ["true"] } } },
    { "Sid": "ReadACommandThatWasSent", "Effect": "Allow", "Action": ["ssm:GetCommandInvocation"], "Resource": ["*"] },
    { "Sid": "ReadACommandThatWasSent", "Effect": "Allow", "Action": ["ssm:ListCommands"], "Resource": ["*"] },
    { "Effect": "Allow", "Action": "ec2:Describe*", "Resource": "*", "Sid": "" }
  ]
}
